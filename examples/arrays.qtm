// Array operations example

fn sum_array(numbers: [int]) -> int {
    let total = 0
    let mut i = 0

    while i < 5 {
        total = total + numbers[i]
        i = i + 1
    }

    return total
}

fn find_max(numbers: [int]) -> int {
    let max = numbers[0]
    let mut i = 1

    while i < 5 {
        if numbers[i] > max {
            max = numbers[i]
        }
        i = i + 1
    }

    return max
}

fn main() {
    let numbers = [10, 25, 5, 40, 15]

    print("Array: [10, 25, 5, 40, 15]")

    let total = sum_array(numbers)
    print("Sum:")
    print(total)

    let maximum = find_max(numbers)
    print("Max:")
    print(maximum)

    // Array access
    print("First element:")
    print(numbers[0])

    print("Last element:")
    print(numbers[4])
}

// ── Data Cleaner, HF Streamer, Training Pipeline ───────────────────
extern "C" {
    fn qai_cleaner_new() -> i64
    fn qai_cleaner_free(h: i64)
    fn qai_cleaner_run(h: i64, ds: i64) -> i64
    fn qai_cleaner_fill(h: i64, strategy: string)
    fn qai_cleaner_outliers(h: i64, strategy: string, sigma: float)
    fn qai_cleaner_no_scale(h: i64)
    fn qai_hf_new(name: string, split: string) -> i64
    fn qai_hf_free(h: i64)
    fn qai_hf_connect(h: i64) -> int
    fn qai_hf_next_batch(h: i64) -> i64
    fn qai_hf_is_done(h: i64) -> int
    fn qai_hf_progress(h: i64) -> float
    fn qai_hf_summary(h: i64)
    fn qai_hf_batch_size(h: i64, n: int)
    fn qai_training_pipeline_new(seq: i64, viz_path: string) -> i64
    fn qai_training_pipeline_free(h: i64)
    fn qai_training_pipeline_fit(h: i64, train: i64, val: i64, epochs: int, batch: int, lr: float)
    fn qai_training_pipeline_fit_streaming(h: i64, streamer: i64, ep_per_batch: int, lr: float)
    fn qai_training_pipeline_set_cleaner(h: i64, cleaner: i64)
    fn qai_training_pipeline_early_stop(h: i64, patience: int)
}

fn cleaner_new() -> i64 { return qai_cleaner_new() }
fn cleaner_free(h: i64) { qai_cleaner_free(h) }
fn cleaner_run(h: i64, ds: i64) -> i64 { return qai_cleaner_run(h, ds) }
fn cleaner_fill(h: i64, strategy: string) { qai_cleaner_fill(h, strategy) }
fn cleaner_outliers(h: i64, strategy: string, sigma: float) { qai_cleaner_outliers(h, strategy, sigma) }
fn cleaner_no_scale(h: i64) { qai_cleaner_no_scale(h) }

fn hf_stream(dataset_name: string, split: string) -> i64 { return qai_hf_new(dataset_name, split) }
fn hf_free(h: i64) { qai_hf_free(h) }
fn hf_connect(h: i64) -> bool { return qai_hf_connect(h) != 0 }
fn hf_next_batch(h: i64) -> i64 { return qai_hf_next_batch(h) }
fn hf_is_done(h: i64) -> bool { return qai_hf_is_done(h) != 0 }
fn hf_progress(h: i64) -> float { return qai_hf_progress(h) }
fn hf_summary(h: i64) { qai_hf_summary(h) }
fn hf_batch_size(h: i64, n: int) { qai_hf_batch_size(h, n) }

fn training_pipeline_new(seq: i64, viz_path: string) -> i64 { return qai_training_pipeline_new(seq, viz_path) }
fn training_pipeline_free(h: i64) { qai_training_pipeline_free(h) }
fn training_pipeline_fit(h: i64, train: i64, val: i64, epochs: int, batch: int, lr: float) {
    qai_training_pipeline_fit(h, train, val, epochs, batch, lr)
}
fn training_pipeline_fit_streaming(h: i64, streamer: i64, ep_per_batch: int, lr: float) {
    qai_training_pipeline_fit_streaming(h, streamer, ep_per_batch, lr)
}
fn training_pipeline_set_cleaner(h: i64, cleaner: i64) { qai_training_pipeline_set_cleaner(h, cleaner) }
fn training_pipeline_early_stop(h: i64, patience: int) { qai_training_pipeline_early_stop(h, patience) }

// ── Multi-Modal Output Model ────────────────────────────────────────
extern "C" {
    fn qai_multimodal_new(name: string, input_dim: int, d_model: int, modalities: string) -> i64
    fn qai_multimodal_free(h: i64)
    fn qai_multimodal_summary(h: i64)
    fn qai_multimodal_forward(h: i64, ds: i64) -> i64
    fn qai_multimodal_forward_text(h: i64, ds: i64) -> i64
    fn qai_multimodal_forward_audio(h: i64, ds: i64) -> i64
    fn qai_multimodal_forward_video(h: i64, ds: i64) -> i64
    fn qai_multimodal_forward_image(h: i64, ds: i64) -> i64
    fn qai_multimodal_train(h: i64, ds: i64, epochs: int, lr: float, verbose: int)
    fn qai_multimodal_gen_audio(h: i64, ds: i64, n_frames: int) -> i64
    fn qai_multimodal_gen_image(h: i64, ds: i64) -> i64
    fn qai_multimodal_gen_text(h: i64, ds: i64, max_tokens: int) -> int
    fn qai_multimodal_n_params(h: i64) -> int
    fn qai_multimodal_n_modalities(h: i64) -> int
}

// Create a multi-modal model with any combination of output heads.
// modalities: "text", "audio", "video", "image", or combinations
// like "text,audio" or "text,audio,video,image"
//
// Example:
//   let mm = qai.multimodal_new("MyModel", 512, 256, "text,audio,image")
//   qai.multimodal_summary(mm)
//   let ds = qai.make_classification(100, 512, 4)
//   qai.multimodal_train(mm, ds, 50, 0.001)
//   let text_out = qai.multimodal_gen_text(mm, ds, 20)
//   let audio_out = qai.multimodal_gen_audio(mm, ds, 100)
//   let image_out = qai.multimodal_gen_image(mm, ds)
fn multimodal_new(name: string, input_dim: int, d_model: int, modalities: string) -> i64 {
    return qai_multimodal_new(name, input_dim, d_model, modalities)
}
fn multimodal_free(h: i64) { qai_multimodal_free(h) }
fn multimodal_summary(h: i64) { qai_multimodal_summary(h) }
fn multimodal_n_params(h: i64) -> int { return qai_multimodal_n_params(h) }
fn multimodal_n_modalities(h: i64) -> int { return qai_multimodal_n_modalities(h) }

// Forward pass — returns shared representation tensor
fn multimodal_forward(h: i64, ds: i64) -> i64 { return qai_multimodal_forward(h, ds) }

// Per-modality forward passes
fn multimodal_text(h: i64, ds: i64) -> i64 { return qai_multimodal_forward_text(h, ds) }
fn multimodal_audio(h: i64, ds: i64) -> i64 { return qai_multimodal_forward_audio(h, ds) }
fn multimodal_video(h: i64, ds: i64) -> i64 { return qai_multimodal_forward_video(h, ds) }
fn multimodal_image(h: i64, ds: i64) -> i64 { return qai_multimodal_forward_image(h, ds) }

// Train all heads jointly
fn multimodal_train(h: i64, ds: i64, epochs: int, lr: float) {
    qai_multimodal_train(h, ds, epochs, lr, 1)
}
fn multimodal_train_quiet(h: i64, ds: i64, epochs: int, lr: float) {
    qai_multimodal_train(h, ds, epochs, lr, 0)
}

// Generation
fn multimodal_gen_text(h: i64, ds: i64, max_tokens: int) -> int {
    return qai_multimodal_gen_text(h, ds, max_tokens)
}
fn multimodal_gen_audio(h: i64, ds: i64, n_frames: int) -> i64 {
    return qai_multimodal_gen_audio(h, ds, n_frames)
}
fn multimodal_gen_image(h: i64, ds: i64) -> i64 {
    return qai_multimodal_gen_image(h, ds)
}

// ── Chat Interface ──────────────────────────────────────────────────
extern "C" {
    fn qai_chat_new(seq: i64) -> i64
    fn qai_chat_free(h: i64)
    fn qai_chat_respond(h: i64, msg: string)
    fn qai_chat_loop(h: i64)
    fn qai_chat_stats(h: i64)
    fn qai_chat_set_system(h: i64, prompt: string)
    fn qai_chat_set_temp(h: i64, temperature: float)
    fn qai_chat_set_modality(h: i64, modality: string)
    fn qai_chat_history_len(h: i64) -> int
    fn qai_distill(teacher: i64, student: i64, ds: i64, epochs: int, temperature: float, verbose: int)
    fn qai_model_merge(a: i64, b: i64, alpha: float) -> i64
}

// Create a chat session from a trained model.
// After training call: let chat = qai.chat_new(model)
// Then: qai.chat_respond(chat, "hello") to get a response
// Or:   qai.chat_loop(chat) for interactive stdin chat
fn chat_new(seq: i64) -> i64 { return qai_chat_new(seq) }
fn chat_free(h: i64) { qai_chat_free(h) }
fn chat_respond(h: i64, message: string) { qai_chat_respond(h, message) }
fn chat_loop(h: i64) { qai_chat_loop(h) }
fn chat_stats(h: i64) { qai_chat_stats(h) }
fn chat_set_system(h: i64, prompt: string) { qai_chat_set_system(h, prompt) }
fn chat_set_temp(h: i64, temperature: float) { qai_chat_set_temp(h, temperature) }
fn chat_set_modality(h: i64, modality: string) { qai_chat_set_modality(h, modality) }
fn chat_history_len(h: i64) -> int { return qai_chat_history_len(h) }

// Knowledge distillation: teacher model trains student model.
// The teacher shares its learned "soft labels" so the student
// learns not just what the answer is, but HOW CONFIDENT the
// teacher is — like reading another mind's reasoning, not just answers.
// temperature: higher = softer distributions = more knowledge transfer
fn distill(teacher: i64, student: i64, ds: i64, epochs: int, temperature: float) {
    qai_distill(teacher, student, ds, epochs, temperature, 1)
}

// Merge two models by interpolating their weights.
// alpha=1.0 means all model A, alpha=0.0 means all model B
fn model_merge(a: i64, b: i64, alpha: float) -> i64 {
    return qai_model_merge(a, b, alpha)
}

// ── Real data loading and proper model creation ─────────────────────
extern "C" {
    fn qai_create_for_dataset(task: string, n_features: int, n_classes: int) -> i64
    fn qai_download_dataset(name: string, out_path: string) -> int
    fn qai_load_csv(path: string, n_features: int, label_col: int, skip_header: int) -> i64
}

// Create a model with correct architecture for your data dimensions.
// This is the RIGHT way to use create() — always pass your actual
// feature count and number of output classes.
// Examples:
//   let model = qai.create_for("classifier", 4, 3)  // iris: 4 features, 3 classes
//   let model = qai.create_for("regressor",  8, 1)  // 8 features, 1 output
//   let model = qai.create_for("binary",    13, 2)  // 13 features, binary output
fn create_for(task: string, n_features: int, n_classes: int) -> i64 {
    return qai_create_for_dataset(task, n_features, n_classes)
}

// Download a built-in dataset from GitHub
// Available: "iris", "titanic", "diabetes", "housing", "wine", "mnist_sample"
// Returns 1 on success, 0 on failure
fn download_dataset(name: string, save_path: string) -> bool {
    return qai_download_dataset(name, save_path) != 0
}

// Load a CSV file as a Dataset
// n_features: number of input columns
// label_col:  which column index is the label/target (0-indexed)
// skip_header: 1 to skip the first row, 0 to include it
fn load_csv(path: string, n_features: int, label_col: int, skip_header: int) -> i64 {
    return qai_load_csv(path, n_features, label_col, skip_header)
}

// ── Deep Learning: RNN, LSTM, GRU, CNN ─────────────────────────────
// Full implementations with real math — not stubs.

extern "C" {
    fn qai_rnn_new(input_size: int, hidden_size: int, n_outputs: int, bidirectional: int) -> i64
    fn qai_rnn_free(h: i64)
    fn qai_rnn_summary(h: i64)
    fn qai_rnn_n_params(h: i64) -> int
    fn qai_rnn_forward(h: i64, ds: i64) -> i64
    fn qai_lstm_layer_new(input_size: int, hidden_size: int, n_layers: int, n_outputs: int) -> i64
    fn qai_lstm_layer_free(h: i64)
    fn qai_lstm_layer_summary(h: i64)
    fn qai_lstm_layer_n_params(h: i64) -> int
    fn qai_lstm_layer_forward(h: i64, ds: i64) -> i64
    fn qai_gru_layer_new(input_size: int, hidden_size: int, n_outputs: int) -> i64
    fn qai_gru_layer_free(h: i64)
    fn qai_gru_layer_summary(h: i64)
    fn qai_gru_layer_n_params(h: i64) -> int
    fn qai_gru_layer_forward(h: i64, ds: i64) -> i64
    fn qai_cnn_new(in_channels: int, n_outputs: int) -> i64
    fn qai_cnn_free(h: i64)
    fn qai_cnn_summary(h: i64)
    fn qai_cnn_n_params(h: i64) -> int
    fn qai_cnn_forward(h: i64, ds: i64) -> i64
    fn qai_autotrainer_new(seq: i64) -> i64
    fn qai_autotrainer_free(h: i64)
    fn qai_autotrainer_set_target_acc(h: i64, acc: float)
    fn qai_autotrainer_set_target_loss(h: i64, loss: float)
    fn qai_autotrainer_set_max_epochs(h: i64, n: int)
    fn qai_autotrainer_set_patience(h: i64, n: int)
    fn qai_autotrainer_fit(h: i64, ds: i64)
    fn qai_autotrainer_reached_target(h: i64) -> int
    fn qai_autotrainer_best_acc(h: i64) -> float
    fn qai_autotrainer_best_loss(h: i64) -> float
    fn qai_autotrainer_epochs_trained(h: i64) -> int
    fn qai_analyze_dataset(ds: i64) -> i64
    fn qai_analysis_free(h: i64)
    fn qai_analysis_recommended_lr(h: i64) -> float
    fn qai_analysis_recommended_epochs(h: i64) -> int
    fn qai_analysis_recommended_batch(h: i64) -> int
    fn qai_analysis_create_model(h: i64) -> i64
    fn qai_analysis_n_issues(h: i64) -> int
}

// RNN — Recurrent Neural Network for sequences
// Good for: time series, sensor data, stock prices
// input_size: features per time step
// hidden_size: internal memory size (try 64-256)
// n_outputs: classes or regression outputs
fn rnn_new(input_size: int, hidden_size: int, n_outputs: int) -> i64 {
    return qai_rnn_new(input_size, hidden_size, n_outputs, 0)
}
fn rnn_bidirectional(input_size: int, hidden_size: int, n_outputs: int) -> i64 {
    return qai_rnn_new(input_size, hidden_size, n_outputs, 1)
}
fn rnn_free(h: i64) { qai_rnn_free(h) }
fn rnn_summary(h: i64) { qai_rnn_summary(h) }
fn rnn_n_params(h: i64) -> int { return qai_rnn_n_params(h) }
fn rnn_forward(h: i64, ds: i64) -> i64 { return qai_rnn_forward(h, ds) }

// LSTM — Long Short-Term Memory
// Best for: text, language, long sequences with long-range dependencies
// n_layers: stacked LSTM depth (1-3 typical)
fn lstm_new(input_size: int, hidden_size: int, n_layers: int, n_outputs: int) -> i64 {
    return qai_lstm_layer_new(input_size, hidden_size, n_layers, n_outputs)
}
fn lstm_free(h: i64) { qai_lstm_layer_free(h) }
fn lstm_summary(h: i64) { qai_lstm_layer_summary(h) }
fn lstm_n_params(h: i64) -> int { return qai_lstm_layer_n_params(h) }
fn lstm_forward(h: i64, ds: i64) -> i64 { return qai_lstm_layer_forward(h, ds) }

// GRU — Gated Recurrent Unit
// Faster than LSTM, often similar accuracy. Good default for sequences.
fn gru_new(input_size: int, hidden_size: int, n_outputs: int) -> i64 {
    return qai_gru_layer_new(input_size, hidden_size, n_outputs)
}
fn gru_free(h: i64) { qai_gru_layer_free(h) }
fn gru_summary(h: i64) { qai_gru_layer_summary(h) }
fn gru_n_params(h: i64) -> int { return qai_gru_layer_n_params(h) }
fn gru_forward(h: i64, ds: i64) -> i64 { return qai_gru_layer_forward(h, ds) }

// CNN — 1D Convolutional Neural Network
// Good for: pattern detection in sequences, text classification, audio
fn cnn_new(in_channels: int, n_outputs: int) -> i64 {
    return qai_cnn_new(in_channels, n_outputs)
}
fn cnn_free(h: i64) { qai_cnn_free(h) }
fn cnn_summary(h: i64) { qai_cnn_summary(h) }
fn cnn_n_params(h: i64) -> int { return qai_cnn_n_params(h) }
fn cnn_forward(h: i64, ds: i64) -> i64 { return qai_cnn_forward(h, ds) }

// AutoTrainer — train until you reach your target accuracy/loss
// The system adjusts learning rate automatically and stops when done.
// Example:
//   let trainer = qai.auto_train(model)
//   qai.auto_train_target_acc(trainer, 0.90)   // stop at 90% accuracy
//   qai.auto_train_target_loss(trainer, 0.05)  // or when loss < 0.05
//   qai.auto_train_fit(trainer, ds)
//   println(qai.auto_train_reached_target(trainer))
fn auto_train(seq: i64) -> i64 { return qai_autotrainer_new(seq) }
fn auto_train_free(h: i64) { qai_autotrainer_free(h) }
fn auto_train_target_acc(h: i64, accuracy: float) { qai_autotrainer_set_target_acc(h, accuracy) }
fn auto_train_target_loss(h: i64, loss: float) { qai_autotrainer_set_target_loss(h, loss) }
fn auto_train_max_epochs(h: i64, n: int) { qai_autotrainer_set_max_epochs(h, n) }
fn auto_train_patience(h: i64, n: int) { qai_autotrainer_set_patience(h, n) }
fn auto_train_fit(h: i64, ds: i64) { qai_autotrainer_fit(h, ds) }
fn auto_train_reached_target(h: i64) -> bool { return qai_autotrainer_reached_target(h) != 0 }
fn auto_train_best_acc(h: i64) -> float { return qai_autotrainer_best_acc(h) }
fn auto_train_best_loss(h: i64) -> float { return qai_autotrainer_best_loss(h) }
fn auto_train_epochs(h: i64) -> int { return qai_autotrainer_epochs_trained(h) }

// Dataset Analysis — auto-detect issues and get recommendations
// Call this before training to understand your data and get the right config.
// Example:
//   let analysis = qai.analyze(ds)
//   let model = qai.analysis_create_model(analysis)
//   qai.seq_compile(model, "adam", "cross_entropy", qai.analysis_lr(analysis))
fn analyze(ds: i64) -> i64 { return qai_analyze_dataset(ds) }
fn analysis_free(h: i64) { qai_analysis_free(h) }
fn analysis_lr(h: i64) -> float { return qai_analysis_recommended_lr(h) }
fn analysis_epochs(h: i64) -> int { return qai_analysis_recommended_epochs(h) }
fn analysis_batch(h: i64) -> int { return qai_analysis_recommended_batch(h) }
fn analysis_create_model(h: i64) -> i64 { return qai_analysis_create_model(h) }
fn analysis_n_issues(h: i64) -> int { return qai_analysis_n_issues(h) }

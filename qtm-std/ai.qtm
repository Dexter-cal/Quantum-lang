// qtm-std/ai.qtm -- QuantumAI v2.1 Full API
// These directives auto-link the QuantumAI shared library.
// Set QAI_LIB_PATH env var or adjust #lib-path to your build directory.
#link "quantumai_sys"
#lib-path "/usr/local/lib/quantum"

// qtm-std/ai.qtm -- QuantumAI v2.1 Full API
// Neural networks, AutoML, benchmarks, NLP, GANs, VAEs, RL, and more.
//
// Quick start:
//   import ai as qai
//   let model = qai.create("classifier")
//   let ds = qai.data.make_classification(1000, 8, 4)
//   qai.model.train(model, ds, epochs: 100, verbose: true)
//   println(qai.model.accuracy(model, ds))
//
// Full docs: see QUANTUMAI_REFERENCE.md
// Requires: --link quantumai_sys --lib-path /path/to/libquantumai_sys.so

extern "C" {
    // Tensor
    fn qai_tensor_free(h: i64)
    fn qai_tensor_len(h: i64) -> int
    fn qai_tensor_ndim(h: i64) -> int
    fn qai_tensor_dim(h: i64, ax: int) -> int
    fn qai_tensor_get(h: i64, i: int) -> float
    fn qai_tensor_set(h: i64, i: int, v: float)
    fn qai_tensor_sum(h: i64) -> float
    fn qai_tensor_mean(h: i64) -> float
    fn qai_tensor_max(h: i64) -> float
    fn qai_tensor_min(h: i64) -> float
    fn qai_tensor_argmax(h: i64) -> int
    fn qai_tensor_std(h: i64) -> float
    fn qai_tensor_print(h: i64)
    fn qai_tensor_from_buf(ptr: i64, len: int, rows: int, cols: int) -> i64

    // Sequential (low-level model builder)
    fn qai_seq_new() -> i64
    fn qai_seq_free(h: i64)
    fn qai_seq_dense(h: i64, in_f: int, out_f: int, activation: string)
    fn qai_seq_batchnorm(h: i64, features: int)
    fn qai_seq_layernorm(h: i64, features: int)
    fn qai_seq_dropout(h: i64, rate: float)
    fn qai_seq_embedding(h: i64, vocab: int, dim: int)
    fn qai_seq_compile(h: i64, optimizer: string, loss: string, lr: float)
    fn qai_seq_summary(h: i64)
    fn qai_seq_fit(h: i64, ds: i64, epochs: int, batch: int, verbose: int)
    fn qai_seq_fit_xy(h: i64, xp: i64, xl: int, xd: int, yp: i64, yl: int, yd: int, ep: int, bs: int, v: int)
    fn qai_seq_predict(h: i64, ds: i64) -> i64
    fn qai_seq_predict_one(h: i64, xp: i64, xd: int) -> i64
    fn qai_seq_predict_class(h: i64, xp: i64, xd: int) -> int
    fn qai_seq_accuracy(h: i64, ds: i64) -> float
    fn qai_seq_save(h: i64, path: string)
    fn qai_seq_load(h: i64, path: string) -> int

    // High-level Model
    fn qai_model_create(task: string) -> i64
    fn qai_model_load_pretrained(name: string, pretrained: int) -> i64
    fn qai_model_free(h: i64)
    fn qai_model_train(h: i64, ds: i64, ep: i64, verbose: int)
    fn qai_model_predict_class(h: i64, xp: i64, xd: int) -> int
    fn qai_model_summary(h: i64)
    fn qai_model_save(h: i64, path: string)
    fn qai_model_plot_history(h: i64)

    // Dataset
    fn qai_ds_free(h: i64)
    fn qai_ds_n_samples(h: i64) -> int
    fn qai_ds_n_features(h: i64) -> int
    fn qai_ds_n_classes(h: i64) -> int
    fn qai_ds_x(h: i64) -> i64
    fn qai_ds_y(h: i64) -> i64
    fn qai_ds_normalize(h: i64)
    fn qai_ds_shuffle(h: i64)
    fn qai_ds_info(h: i64)
    fn qai_ds_split_train(h: i64, r: float) -> i64
    fn qai_ds_split_test(h: i64, r: float) -> i64

    // Synthetic datasets
    fn qai_make_xor(n: int) -> i64
    fn qai_make_sine(n: int) -> i64
    fn qai_make_classification(n: int, nf: int, nc: int) -> i64
    fn qai_make_moons(n: int, noise: float) -> i64
    fn qai_make_circles(n: int, noise: float) -> i64
    fn qai_make_regression(n: int, nf: int, noise: float) -> i64
    fn qai_make_iris(n: int) -> i64
    fn qai_make_spiral(n: int, nc: int) -> i64

    // ML algorithms
    fn qai_linreg_new() -> i64
    fn qai_linreg_free(h: i64)
    fn qai_linreg_fit(h: i64, ds: i64)
    fn qai_linreg_r2(h: i64, ds: i64) -> float
    fn qai_logreg_new() -> i64
    fn qai_logreg_free(h: i64)
    fn qai_logreg_fit(h: i64, ds: i64)
    fn qai_logreg_accuracy(h: i64, ds: i64) -> float
    fn qai_knn_new(k: int) -> i64
    fn qai_knn_free(h: i64)
    fn qai_knn_fit(h: i64, ds: i64)
    fn qai_knn_predict_class(h: i64, xp: i64, len: int, dim: int) -> int
    fn qai_knn_accuracy(h: i64, ds: i64) -> float
    fn qai_dtree_new(max_depth: int) -> i64
    fn qai_dtree_free(h: i64)
    fn qai_dtree_fit(h: i64, ds: i64)
    fn qai_dtree_accuracy(h: i64, ds: i64) -> float
    fn qai_rf_new(n_trees: int, max_depth: int) -> i64
    fn qai_rf_free(h: i64)
    fn qai_rf_fit(h: i64, ds: i64)
    fn qai_rf_accuracy(h: i64, ds: i64) -> float
    fn qai_kmeans_new(k: int) -> i64
    fn qai_kmeans_free(h: i64)
    fn qai_kmeans_fit(h: i64, ds: i64)
    fn qai_kmeans_predict(h: i64, xp: i64, len: int, dim: int) -> int
    fn qai_kmeans_inertia(h: i64, ds: i64) -> float
    fn qai_pca_new(n: int) -> i64
    fn qai_pca_free(h: i64)
    fn qai_pca_fit_transform(h: i64, ds: i64) -> i64
    fn qai_nb_new() -> i64
    fn qai_nb_free(h: i64)
    fn qai_nb_fit(h: i64, ds: i64)
    fn qai_nb_accuracy(h: i64, ds: i64) -> float
    fn qai_gbm_new(n: int, lr: float, depth: int) -> i64
    fn qai_gbm_free(h: i64)
    fn qai_gbm_fit(h: i64, ds: i64)
    fn qai_gbm_accuracy(h: i64, ds: i64) -> float

    // Advanced: VAE, GAN, RL
    fn qai_vae_new(input_dim: int, hidden_dim: int, latent_dim: int) -> i64
    fn qai_vae_free(h: i64)
    fn qai_vae_sample(h: i64, n: int) -> i64
    fn qai_gan_new(latent: int, output: int, hidden: int) -> i64
    fn qai_gan_free(h: i64)
    fn qai_gan_generate(h: i64, n: int) -> i64
    fn qai_gan_summary(h: i64)
    fn qai_ql_new(states: int, actions: int) -> i64
    fn qai_ql_free(h: i64)
    fn qai_ql_act(h: i64, sp: i64, sl: int) -> int
    fn qai_ql_replay(h: i64, batch_size: int)

    // Anomaly detection
    fn qai_anomaly_new(dim: int) -> i64
    fn qai_anomaly_free(h: i64)
    fn qai_anomaly_train(h: i64, ds: i64, epochs: int)
    fn qai_anomaly_score(h: i64, ds: i64) -> float
    fn qai_anomaly_is_anomaly(h: i64, ds: i64) -> int

    // AutoML
    fn qai_automl_new(trials: int) -> i64
    fn qai_automl_free(h: i64)
    fn qai_automl_fit(h: i64, ds: i64)
    fn qai_tune(ds: i64, trials: int) -> float

    // Pretrained models
    fn qai_resnet50(n_classes: int) -> i64
    fn qai_bert_tiny() -> i64
    fn qai_gpt2_mini() -> i64
    fn qai_efficientnet(n_classes: int) -> i64
    fn qai_yolov8() -> i64

    // Benchmarks
    fn qai_benchmark_run(h: i64, train_ds: i64, test_ds: i64, n_classes: int) -> i64
    fn qai_benchmark_free(h: i64)
    fn qai_benchmark_train_acc(h: i64) -> float
    fn qai_benchmark_test_acc(h: i64) -> float
    fn qai_benchmark_inference_ms(h: i64) -> float
    fn qai_benchmark_throughput(h: i64) -> float
    fn qai_benchmark_train_time(h: i64) -> float
    fn qai_benchmark_print(h: i64)
    fn qai_benchmark_summary(h: i64)

    // AI Assistant
    fn qai_assistant_suggest(problem: string)
    fn qai_assistant_guide()
    fn qai_assistant_explain(metric: string, val: float)
    fn qai_assistant_analyze(report: i64)

    // Experiment tracking
    fn qai_experiment_new(name: string) -> i64
    fn qai_experiment_free(h: i64)
    fn qai_experiment_log(h: i64, key: string, val: float)
    fn qai_experiment_finish(h: i64)

    // Cross-validation
    fn qai_crossval_run(ds: i64, task: string, epochs: int, folds: int) -> float

    // DataPipeline
    fn qai_pipeline_load(source: string) -> i64
    fn qai_pipeline_free(h: i64)
    fn qai_pipeline_info(h: i64)
    fn qai_pipeline_to_dataset(h: i64) -> i64

    // Quick train
    fn qai_quick_train(task: string, ds_name: string, epochs: int) -> i64

    // Utility
    fn qai_banner()
}

// ── Float buffer helpers ────────────────────────────────────────────
fn buf_alloc(n: int) -> i64 { return q_alloc(n * 8) }
fn buf_free(h: i64) { q_free(h) }
fn buf_set(h: i64, i: int, v: float) { q_write_f64(h, i, v) }
fn buf_get(h: i64, i: int) -> float { return q_read_f64(h, i) }

// ── Banner ─────────────────────────────────────────────────────────
fn banner() { qai_banner() }

// ── Tensor operations ──────────────────────────────────────────────
fn tensor_free(h: i64) { qai_tensor_free(h) }
fn tensor_len(h: i64) -> int { return qai_tensor_len(h) }
fn tensor_get(h: i64, i: int) -> float { return qai_tensor_get(h, i) }
fn tensor_set(h: i64, i: int, v: float) { qai_tensor_set(h, i, v) }
fn tensor_mean(h: i64) -> float { return qai_tensor_mean(h) }
fn tensor_std(h: i64) -> float { return qai_tensor_std(h) }
fn tensor_max(h: i64) -> float { return qai_tensor_max(h) }
fn tensor_min(h: i64) -> float { return qai_tensor_min(h) }
fn tensor_argmax(h: i64) -> int { return qai_tensor_argmax(h) }
fn tensor_shape_rows(h: i64) -> int { return qai_tensor_dim(h, 0) }
fn tensor_shape_cols(h: i64) -> int { return qai_tensor_dim(h, 1) }
fn tensor_print(h: i64) { qai_tensor_print(h) }

// ── Sequential model ───────────────────────────────────────────────

fn seq_new() -> i64 { return qai_seq_new() }
fn seq_free(h: i64) { qai_seq_free(h) }
fn seq_dense(h: i64, in_f: int, out_f: int, activation: string) { qai_seq_dense(h, in_f, out_f, activation) }
fn seq_batchnorm(h: i64, features: int) { qai_seq_batchnorm(h, features) }
fn seq_layernorm(h: i64, features: int) { qai_seq_layernorm(h, features) }
fn seq_dropout(h: i64, rate: float) { qai_seq_dropout(h, rate) }
fn seq_embedding(h: i64, vocab_size: int, embed_dim: int) { qai_seq_embedding(h, vocab_size, embed_dim) }
fn seq_compile(h: i64, optimizer: string, loss: string, lr: float) { qai_seq_compile(h, optimizer, loss, lr) }
fn seq_summary(h: i64) { qai_seq_summary(h) }
fn seq_fit(h: i64, ds: i64, epochs: int, batch_size: int) { qai_seq_fit(h, ds, epochs, batch_size, 1) }
fn seq_fit_quiet(h: i64, ds: i64, epochs: int, batch_size: int) { qai_seq_fit(h, ds, epochs, batch_size, 0) }
fn seq_accuracy(h: i64, ds: i64) -> float { return qai_seq_accuracy(h, ds) }
fn seq_predict_class(h: i64, x_buf: i64, n_features: int) -> int { return qai_seq_predict_class(h, x_buf, n_features) }
fn seq_predict_one(h: i64, x_buf: i64, n_features: int) -> i64 { return qai_seq_predict_one(h, x_buf, n_features) }
fn seq_save(h: i64, path: string) { qai_seq_save(h, path) }
fn seq_load(h: i64, path: string) -> bool { return qai_seq_load(h, path) != 0 }

// ── High-level Model ───────────────────────────────────────────────

// Create pre-configured model by task:
//   "classifier"  - multi-class neural network
//   "regressor"   - regression network
//   "binary"      - binary classification
//   "nlp"         - text classification
//   "autoencoder" - dimensionality reduction
//   "timeseries"  - sequence prediction
fn create(task: string) -> i64 { return qai_model_create(task) }

// Load a pretrained architecture:
//   "resnet50", "bert-tiny", "gpt2-mini", "efficientnet-b0"
fn load(name: string) -> i64 { return qai_model_load_pretrained(name, 0) }
fn load_pretrained(name: string) -> i64 { return qai_model_load_pretrained(name, 1) }

fn model_free(h: i64) { qai_model_free(h) }
fn model_train(h: i64, ds: i64, epochs: int) { qai_model_train(h, ds, epochs, 1) }
fn model_train_quiet(h: i64, ds: i64, epochs: int) { qai_model_train(h, ds, epochs, 0) }
fn model_predict_class(h: i64, x_buf: i64, n_features: int) -> int { return qai_model_predict_class(h, x_buf, n_features) }
fn model_summary(h: i64) { qai_model_summary(h) }
fn model_save(h: i64, path: string) { qai_model_save(h, path) }
fn model_plot_history(h: i64) { qai_model_plot_history(h) }

// ── Dataset ────────────────────────────────────────────────────────

fn dataset_free(h: i64) { qai_ds_free(h) }
fn dataset_n_samples(h: i64) -> int { return qai_ds_n_samples(h) }
fn dataset_n_features(h: i64) -> int { return qai_ds_n_features(h) }
fn dataset_n_classes(h: i64) -> int { return qai_ds_n_classes(h) }
fn dataset_x(h: i64) -> i64 { return qai_ds_x(h) }
fn dataset_y(h: i64) -> i64 { return qai_ds_y(h) }
fn dataset_normalize(h: i64) { qai_ds_normalize(h) }
fn dataset_shuffle(h: i64) { qai_ds_shuffle(h) }
fn dataset_info(h: i64) { qai_ds_info(h) }
fn dataset_train_split(h: i64, test_ratio: float) -> i64 { return qai_ds_split_train(h, test_ratio) }
fn dataset_test_split(h: i64, test_ratio: float) -> i64 { return qai_ds_split_test(h, test_ratio) }

// ── Synthetic datasets ─────────────────────────────────────────────

fn make_xor(n_samples: int) -> i64 { return qai_make_xor(n_samples) }
fn make_sine(n_samples: int) -> i64 { return qai_make_sine(n_samples) }
fn make_classification(n_samples: int, n_features: int, n_classes: int) -> i64 { return qai_make_classification(n_samples, n_features, n_classes) }
fn make_moons(n_samples: int, noise: float) -> i64 { return qai_make_moons(n_samples, noise) }
fn make_circles(n_samples: int, noise: float) -> i64 { return qai_make_circles(n_samples, noise) }
fn make_regression(n_samples: int, n_features: int, noise: float) -> i64 { return qai_make_regression(n_samples, n_features, noise) }
fn make_iris(n_samples: int) -> i64 { return qai_make_iris(n_samples) }
fn make_spiral(n_samples: int, n_classes: int) -> i64 { return qai_make_spiral(n_samples, n_classes) }

// ── ML algorithms ──────────────────────────────────────────────────

fn linreg_new() -> i64 { return qai_linreg_new() }
fn linreg_free(h: i64) { qai_linreg_free(h) }
fn linreg_fit(h: i64, ds: i64) { qai_linreg_fit(h, ds) }
fn linreg_r2(h: i64, ds: i64) -> float { return qai_linreg_r2(h, ds) }

fn logreg_new() -> i64 { return qai_logreg_new() }
fn logreg_free(h: i64) { qai_logreg_free(h) }
fn logreg_fit(h: i64, ds: i64) { qai_logreg_fit(h, ds) }
fn logreg_accuracy(h: i64, ds: i64) -> float { return qai_logreg_accuracy(h, ds) }

fn knn_new(k: int) -> i64 { return qai_knn_new(k) }
fn knn_free(h: i64) { qai_knn_free(h) }
fn knn_fit(h: i64, ds: i64) { qai_knn_fit(h, ds) }
fn knn_predict(h: i64, x_buf: i64, n: int, dim: int) -> int { return qai_knn_predict_class(h, x_buf, n, dim) }
fn knn_accuracy(h: i64, ds: i64) -> float { return qai_knn_accuracy(h, ds) }

fn dtree_new(max_depth: int) -> i64 { return qai_dtree_new(max_depth) }
fn dtree_free(h: i64) { qai_dtree_free(h) }
fn dtree_fit(h: i64, ds: i64) { qai_dtree_fit(h, ds) }
fn dtree_accuracy(h: i64, ds: i64) -> float { return qai_dtree_accuracy(h, ds) }

fn rf_new(n_trees: int, max_depth: int) -> i64 { return qai_rf_new(n_trees, max_depth) }
fn rf_free(h: i64) { qai_rf_free(h) }
fn rf_fit(h: i64, ds: i64) { qai_rf_fit(h, ds) }
fn rf_accuracy(h: i64, ds: i64) -> float { return qai_rf_accuracy(h, ds) }

fn kmeans_new(k: int) -> i64 { return qai_kmeans_new(k) }
fn kmeans_free(h: i64) { qai_kmeans_free(h) }
fn kmeans_fit(h: i64, ds: i64) { qai_kmeans_fit(h, ds) }
fn kmeans_predict(h: i64, x_buf: i64, n: int, dim: int) -> int { return qai_kmeans_predict(h, x_buf, n, dim) }
fn kmeans_inertia(h: i64, ds: i64) -> float { return qai_kmeans_inertia(h, ds) }

fn pca_new(n_components: int) -> i64 { return qai_pca_new(n_components) }
fn pca_free(h: i64) { qai_pca_free(h) }
fn pca_fit_transform(h: i64, ds: i64) -> i64 { return qai_pca_fit_transform(h, ds) }

fn nb_new() -> i64 { return qai_nb_new() }
fn nb_free(h: i64) { qai_nb_free(h) }
fn nb_fit(h: i64, ds: i64) { qai_nb_fit(h, ds) }
fn nb_accuracy(h: i64, ds: i64) -> float { return qai_nb_accuracy(h, ds) }

fn gbm_new(n_estimators: int, lr: float, max_depth: int) -> i64 { return qai_gbm_new(n_estimators, lr, max_depth) }
fn gbm_free(h: i64) { qai_gbm_free(h) }
fn gbm_fit(h: i64, ds: i64) { qai_gbm_fit(h, ds) }
fn gbm_accuracy(h: i64, ds: i64) -> float { return qai_gbm_accuracy(h, ds) }

// ── Advanced models ────────────────────────────────────────────────

fn vae_new(input_dim: int, hidden_dim: int, latent_dim: int) -> i64 { return qai_vae_new(input_dim, hidden_dim, latent_dim) }
fn vae_free(h: i64) { qai_vae_free(h) }
fn vae_sample(h: i64, n: int) -> i64 { return qai_vae_sample(h, n) }

fn gan_new(latent_dim: int, output_dim: int, hidden_dim: int) -> i64 { return qai_gan_new(latent_dim, output_dim, hidden_dim) }
fn gan_free(h: i64) { qai_gan_free(h) }
fn gan_generate(h: i64, n: int) -> i64 { return qai_gan_generate(h, n) }
fn gan_summary(h: i64) { qai_gan_summary(h) }

fn ql_new(state_size: int, action_size: int) -> i64 { return qai_ql_new(state_size, action_size) }
fn ql_free(h: i64) { qai_ql_free(h) }
fn ql_act(h: i64, state_buf: i64, state_len: int) -> int { return qai_ql_act(h, state_buf, state_len) }
fn ql_replay(h: i64, batch_size: int) { qai_ql_replay(h, batch_size) }

// ── Anomaly detection ──────────────────────────────────────────────

fn anomaly_new(input_dim: int) -> i64 { return qai_anomaly_new(input_dim) }
fn anomaly_free(h: i64) { qai_anomaly_free(h) }
fn anomaly_train(h: i64, ds: i64, epochs: int) { qai_anomaly_train(h, ds, epochs) }
fn anomaly_score(h: i64, ds: i64) -> float { return qai_anomaly_score(h, ds) }
fn anomaly_is_anomaly(h: i64, ds: i64) -> bool { return qai_anomaly_is_anomaly(h, ds) != 0 }

// ── AutoML ─────────────────────────────────────────────────────────

fn automl_new(n_trials: int) -> i64 { return qai_automl_new(n_trials) }
fn automl_free(h: i64) { qai_automl_free(h) }
fn automl_fit(h: i64, ds: i64) { qai_automl_fit(h, ds) }
fn tune(ds: i64, n_trials: int) -> float { return qai_tune(ds, n_trials) }

// ── Pretrained models ──────────────────────────────────────────────

fn resnet50(n_classes: int) -> i64 { return qai_resnet50(n_classes) }
// Pretrained models return Sequential handles — use seq_free() not model_free()
fn bert_tiny() -> i64 { return qai_bert_tiny() }
fn gpt2_mini() -> i64 { return qai_gpt2_mini() }
fn efficientnet(n_classes: int) -> i64 { return qai_efficientnet(n_classes) }
fn yolov8() -> i64 { return qai_yolov8() }

// ── Benchmarks ─────────────────────────────────────────────────────

fn benchmark_run(model: i64, train_ds: i64, test_ds: i64, n_classes: int) -> i64 {
    return qai_benchmark_run(model, train_ds, test_ds, n_classes)
}
fn benchmark_free(h: i64) { qai_benchmark_free(h) }
fn benchmark_train_acc(h: i64) -> float { return qai_benchmark_train_acc(h) }
fn benchmark_test_acc(h: i64) -> float { return qai_benchmark_test_acc(h) }
fn benchmark_inference_ms(h: i64) -> float { return qai_benchmark_inference_ms(h) }
fn benchmark_throughput(h: i64) -> float { return qai_benchmark_throughput(h) }
fn benchmark_train_time(h: i64) -> float { return qai_benchmark_train_time(h) }
fn benchmark_print(h: i64) { qai_benchmark_print(h) }
fn benchmark_summary(h: i64) { qai_benchmark_summary(h) }


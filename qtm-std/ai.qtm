// ── LoRA fine-tuning ───────────────────────────────────────────────
// Wrap a base model with low-rank adapters for parameter-efficient
// fine-tuning. Only rank*in + rank*out params are trained per layer.
fn lora_new(base_model: i64, rank: int, alpha: float) -> i64 {
    return qai_lora_new(base_model, rank, alpha)
}
fn lora_free(h: i64) { qai_lora_free(h) }
fn lora_summary(h: i64) { qai_lora_summary(h) }
fn lora_train(h: i64, ds: i64, epochs: int, lr: float) { qai_lora_train(h, ds, epochs, lr, 1) }
fn lora_n_params(h: i64) -> int { return qai_lora_n_params(h) }

// ── DPO: Direct Preference Optimization ───────────────────────────
// Train on preference pairs (preferred vs rejected responses).
// The 2024-2026 replacement for RLHF — no reward model needed.
fn dpo_new(base_model: i64, beta: float, lr: float) -> i64 {
    return qai_dpo_new(base_model, beta, lr)
}
fn dpo_free(h: i64) { qai_dpo_free(h) }
fn dpo_train(h: i64, preferred_ds: i64, rejected_ds: i64, epochs: int) {
    qai_dpo_train(h, preferred_ds, rejected_ds, epochs, 1)
}
fn dpo_summary(h: i64) { qai_dpo_summary(h) }

// ── Mixture of Experts Transformer ────────────────────────────────
// Architecture behind GPT-4, Mixtral, Gemini.
// Each token routes to top_k of n_experts — large capacity, lower
// compute cost per token than dense transformers.
fn moe_new(n_layers: int, d_model: int, n_heads: int, n_experts: int, top_k: int) -> i64 {
    return qai_moe_new(n_layers, d_model, n_heads, n_experts, top_k)
}
fn moe_free(h: i64) { qai_moe_free(h) }
fn moe_summary(h: i64) { qai_moe_summary(h) }
fn moe_total_params(h: i64) -> int { return qai_moe_total_params(h) }
fn moe_forward(h: i64, ds: i64) -> i64 { return qai_moe_forward(h, ds) }

// ── Flash Attention ────────────────────────────────────────────────
// O(N) memory vs O(N²) for standard attention. Essential for long
// context windows (32K, 128K, 1M tokens).
fn flash_attn_new(n_heads: int, head_dim: int) -> i64 {
    return qai_flash_new(n_heads, head_dim)
}
fn flash_attn_free(h: i64) { qai_flash_free(h) }
fn flash_attn_summary(h: i64) { qai_flash_summary(h) }
fn flash_attn_forward(h: i64, q: i64, k: i64, v: i64) -> i64 {
    return qai_flash_forward(h, q, k, v)
}

// ── Rotary Position Embeddings (RoPE) ──────────────────────────────
// Used in LLaMA, Mistral, Gemma, Phi — better length generalization
// than learned absolute position embeddings.
fn rope_new(dim: int, max_seq_len: int) -> i64 {
    return qai_rope_new(dim, max_seq_len)
}
fn rope_free(h: i64) { qai_rope_free(h) }
fn rope_apply(h: i64, tensor: i64) -> i64 { return qai_rope_apply(h, tensor) }

// ── KV Cache ───────────────────────────────────────────────────────
// Essential for efficient LLM inference — avoid recomputing attention
// for all previous tokens on every new generation step.
fn kvcache_new(max_seq_len: int, n_heads: int, head_dim: int) -> i64 {
    return qai_kvcache_new(max_seq_len, n_heads, head_dim)
}
fn kvcache_free(h: i64) { qai_kvcache_free(h) }
fn kvcache_update(h: i64, k: i64, v: i64) { qai_kvcache_update(h, k, v) }
fn kvcache_len(h: i64) -> int { return qai_kvcache_len(h) }
fn kvcache_memory_mb(h: i64) -> float { return qai_kvcache_memory_mb(h) }
fn kvcache_summary(h: i64) { qai_kvcache_summary(h) }

// ── RAG: Retrieval-Augmented Generation ────────────────────────────
// The dominant 2024-2026 LLM deployment pattern.
// Retrieves relevant context from a vector store at query time.
fn rag_new(embed_dim: int, top_k: int) -> i64 {
    return qai_rag_new(embed_dim, top_k)
}
fn rag_free(h: i64) { qai_rag_free(h) }
fn rag_add_doc(h: i64, text: string, emb_buf: i64, embed_dim: int) {
    qai_rag_add(h, text, emb_buf, embed_dim)
}
fn rag_n_docs(h: i64) -> int { return qai_rag_n_docs(h) }
fn rag_summary(h: i64) { qai_rag_summary(h) }
fn rag_retrieve_score(h: i64, query_emb_buf: i64, embed_dim: int) -> float {
    return qai_rag_top_score(h, query_emb_buf, embed_dim)
}

// ── Diffusion Model ────────────────────────────────────────────────
// Architecture behind Stable Diffusion, DALL-E 3, Sora.
// Learns to denoise progressively via a learned score function.
fn diffusion_new(data_dim: int, hidden_dim: int, n_steps: int) -> i64 {
    return qai_diffusion_new(data_dim, hidden_dim, n_steps)
}
fn diffusion_free(h: i64) { qai_diffusion_free(h) }
fn diffusion_summary(h: i64) { qai_diffusion_summary(h) }
fn diffusion_sample(h: i64, n_samples: int) -> i64 {
    return qai_diffusion_sample(h, n_samples)
}
fn diffusion_steps(h: i64) -> int { return qai_diffusion_steps(h) }

// ── Mamba / SSM: State Space Model ────────────────────────────────
// O(N) vs O(N²) for attention. Excels at very long sequences.
// Used in Mamba-1, Mamba-2, Jamba (hybrid with attention).
fn mamba_new(d_model: int, d_state: int) -> i64 {
    return qai_mamba_new(d_model, d_state)
}
fn mamba_free(h: i64) { qai_mamba_free(h) }
fn mamba_summary(h: i64) { qai_mamba_summary(h) }
fn mamba_n_params(h: i64) -> int { return qai_mamba_n_params(h) }
fn mamba_forward(h: i64, ds: i64) -> i64 { return qai_mamba_forward(h, ds) }

// ── Model Quantization ─────────────────────────────────────────────
// int8 quantization: 8x smaller, 2-4x faster inference.
fn quantize(model: i64) -> float { return qai_quantize(model) }
fn quantize_report(model: i64) { qai_quantize_report(model) }

// ── CLIP: Multi-Modal Vision+Language ─────────────────────────────
// Encodes images and text into a shared embedding space.
// Foundation for GPT-4V, LLaVA, Flamingo, Gemini.
fn clip_new(vision_dim: int, text_dim: int, embed_dim: int) -> i64 {
    return qai_clip_new(vision_dim, text_dim, embed_dim)
}
fn clip_free(h: i64) { qai_clip_free(h) }
fn clip_summary(h: i64) { qai_clip_summary(h) }
fn clip_encode_vision(h: i64, ds: i64) -> i64 { return qai_clip_encode_vision(h, ds) }
fn clip_encode_text(h: i64, ds: i64) -> i64 { return qai_clip_encode_text(h, ds) }
fn clip_n_params(h: i64) -> int { return qai_clip_n_params(h) }

// ── AI Agent ───────────────────────────────────────────────────────
// ReAct-style agent: reason + act in a loop using tools.
// The dominant 2025-2026 deployment pattern for complex tasks.
fn agent_new(name: string) -> i64 { return qai_agent_new(name) }
fn agent_free(h: i64) { qai_agent_free(h) }
fn agent_add_tool(h: i64, tool_name: string) { qai_agent_add_tool(h, tool_name) }
fn agent_remember(h: i64, fact: string) { qai_agent_remember(h, fact) }
fn agent_run(h: i64, task: string) -> int { return qai_agent_run(h, task) }
fn agent_summary(h: i64) { qai_agent_summary(h) }

// ── Trillion-Parameter Scaling ─────────────────────────────────────
// Define arbitrarily large model architectures.
// Actual training at this scale requires distributed infrastructure,
// but Quantum can define, describe, and run inference on the architecture.
fn scale(task: string, params_billions: float) -> i64 {
    return qai_scale(task, params_billions)
}


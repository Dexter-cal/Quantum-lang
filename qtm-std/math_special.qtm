// qtm-std/math_special.qtm — Quantum Special Math, Interpolation & Bitwise Utilities

fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

fn clamp01(x: float) -> float {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn smoothstep(edge0: float, edge1: float, x: float) -> float {
    let t = clamp01((x - edge0) / (edge1 - edge0))
    return t * t * (3.0 - 2.0 * t)
}

fn map_range(val: float, in_min: float, in_max: float, out_min: float, out_max: float) -> float {
    return out_min + (val - in_min) * (out_max - out_min) / (in_max - in_min)
}

fn popcount(n: int) -> int {
    let mut count = 0
    let mut temp = n
    while temp > 0 {
        count = count + (temp & 1)
        temp = temp >> 1
    }
    return count
}

// qtm-std/system.qtm — Comprehensive System Standard Library for Quantum
// System Info, Environment, Process Control, Memory, Timers, and App Lifecycle

extern "C" {
    fn getenv(name: string) -> string
    fn system(cmd: string) -> int
    fn time(ptr: int) -> int
    fn usleep(usec: int) -> int
    fn clock() -> int
    fn exit(code: int)
}

// ── system.info ──────────────────────────────────────────
fn info_os_name() -> string {
    return "Linux"
}

fn info_architecture() -> string {
    return "x64"
}

fn info_username() -> string {
    let u = getenv("USER")
    if q_str_len(u) == 0 {
        return "user"
    }
    return u
}

fn info_home_dir() -> string {
    let h = getenv("HOME")
    if q_str_len(h) == 0 {
        return "/home"
    }
    return h
}

fn info_temp_dir() -> string {
    return "/tmp"
}

// ── system.env ───────────────────────────────────────────
fn env_get(name: string) -> string {
    return getenv(name)
}

fn env_exists(name: string) -> bool {
    let val = getenv(name)
    return q_str_len(val) > 0
}

// ── system.process ───────────────────────────────────────
fn process_spawn(command: string) -> int {
    return system(command)
}

// ── system.timer ─────────────────────────────────────────
fn timer_now() -> int {
    return time(0)
}

fn timer_sleep_ms(ms: int) {
    usleep(ms * 1000)
}

fn timer_sleep_sec(sec: int) {
    usleep(sec * 1000000)
}

// ── system.app ───────────────────────────────────────────
fn app_exit(code: int) {
    exit(code)
}

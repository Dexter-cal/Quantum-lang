import math_complex

fn main() {
    println("--- Testing Complex Math ---")
    let z1 = Complex { real: 3.0, imag: 4.0 }
    println("Magnitude: " + z1.magnitude().to_string())
    let conj = z1.conjugate()
    println("Conj Imag: " + conj.imag.to_string())
    let z2 = Complex { real: 1.0, imag: 2.0 }
    let sum = z1.add(z2)
    println("Sum Real: " + sum.real.to_string())
}

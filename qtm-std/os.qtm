// qtm-std/os.qtm — Quantum Standard Library Operating System Module
// Environment variables, command execution, working directory and process control

extern "C" {
    fn system(cmd: string) -> int
    fn getenv(name: string) -> string
    fn exit(code: int)
}

fn exec_cmd(command: string) -> int {
    return system(command)
}

fn get_env(variable: string) -> string {
    return getenv(variable)
}

fn exit_process(code: int) {
    exit(code)
}

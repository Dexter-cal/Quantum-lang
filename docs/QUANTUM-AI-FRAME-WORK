91. User-Input Round-Trip & Staged Output Pipeline
Pausing for real human input/clarification mid-logic, Python-`input()`-style:
```
model.logic {
    let raw_input = qai.input.from_user("Ask me anything: ")
    let improved = model.improve_prompt(raw_input)
    let confirmed = qai.input.from_user("Did you mean: '" + improved + "'? (yes/edit): ")
    let final_prompt = confirmed == "yes" ? improved : confirmed
    input(final_prompt)
    output(model.generate(final_prompt))
}
```
Fully self-contained logic (no human pause) remains just as valid and is the more common case:
```
model.logic { input(prompt); let improved = model.improve_prompt(prompt); output(model.generate(improved)) }
```
Full staged output pipeline — output manipulation is rarely one step; here it is properly staged:
```
model.logic {
    input(prompt)
    var draft = model.generate(prompt)                                    // 1. first draft
    while model.confidence(draft) < 0.8 { draft = model.generate(prompt, previous_attempt: draft, instruction: "improve this") }  // 2. self-review loop
    let review = reviewer_model.check(draft)                               // 3. different-model critique
    if review.has_issues { draft = model.generate(prompt, feedback: review.issues) }
    let final = draft.redact(pattern: "emails").format("markdown")          // 4. manipulate before release
        .add_disclaimer_if(review.risk > 0.5).translate(to: user.preferred_language)
    if final.risk_score() > threshold {                                       // 5. human approval gate, only when risky
        qai.output.request_approval(final, on_reject: fn() { draft = model.generate(prompt, feedback: "human rejected") })
    }
    qai.output.log(draft, to: "internal_log.md")                              // 6a. silent internal record
    qai.output.to_user(final)                                                  // 6b. what the person actually sees
    output(final)
}
```
The full `qai.output.*` primitive set:
```
qai.output.to_user(x)               qai.output.stream_to_user(chunk)         qai.output.log(x, to: path)
qai.output.to_format(x, [json, markdown])   qai.output.request_approval(x, on_reject: fn(){})
qai.output.mask(x, pattern)          qai.output.diff(v1, v2)                  qai.output.rollback_to(previous_version)
qai.output.gate(x, condition: fn(x){...})
```
Output feeding back as the next input — a real cycle, not just a straight line:
```
model.logic {
    input(prompt)
    var result = model.generate(prompt)
    while qai.output.needs_more_work(result) { result = model.generate(input: result, instruction: "continue and refine") }
    output(result)
}
```
Supporting ideas: output version history within one request (`result.version_history()`); selective output routing by content (`qai.output.route(result, condition, to: "slack"|"email"|"dashboard")`); an output SLA timer (`qai.output.max_time(5s, fallback: "...")`) forcing release rather than indefinite waiting; A/B output serving across user segments.

{
  "name": "quantum-lang",
  "displayName": "Quantum Language Support",
  "description": "Language support for Quantum programming language",
  "version": "1.0.0",
  "publisher": "quantum-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:quantum"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quantum",
        "aliases": ["Quantum", "quantum"],
        "extensions": [".qtm", ".quantum"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quantum",
        "scopeName": "source.quantum",
        "path": "./syntaxes/quantum.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quantum",
        "path": "./snippets/quantum.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Quantum",
      "properties": {
        "quantum.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the quantum-lsp executable. If empty, 'quantum-lsp' is looked up on PATH (e.g. after `cargo build --release -p quantum-lsp` and adding target/release to PATH)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  }
}
